// overshare.io data model — mirrors the ER diagram in docs/architecture.md.
// No name, dateOfBirth, or address field anywhere: that's a requirement
// (FR-1.3 in docs/product-requirements.md), not an oversight.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String?  @unique
  // Visitor-chosen pseudonym (FR-5.5/5.6), never required, never an identity
  // field — nullable means "Anonymous" everywhere it's rendered, not stored
  // as the literal string.
  displayName String?
  createdAt DateTime @default(now())
  // Presence-heartbeat timestamp (FR-11.4) — updated on a visitor message
  // send and on a lightweight client heartbeat while the widget is open.
  // Distinct from "last message" (Message.createdAt): a visitor can be
  // online with the widget open and not have sent anything recently.
  lastSeenAt DateTime?

  listenerId String?
  // SetNull, not the Restrict default: removing a Listener's listing
  // (FR-9.3, T3.5.6) must not be blocked by — or destroy — past visitor
  // sessions they claimed.
  listener   Listener? @relation(fields: [listenerId], references: [id], onDelete: SetNull)

  queueEntry QueueEntry?
  messages   Message[]
}

model QueueEntry {
  id        String      @id @default(cuid())
  sessionId String      @unique
  session   Session     @relation(fields: [sessionId], references: [id])
  status    QueueStatus @default(WAITING)
  joinedAt  DateTime    @default(now())
  // Set when a Listener claims this entry (Milestone 3). Needed now so the
  // wait-time estimate in docs/challenges/queue-design.md — queue depth
  // divided by recent claim throughput — has something to compute from.
  claimedAt DateTime?

  @@index([status, joinedAt])
  @@index([status, claimedAt])
}

enum QueueStatus {
  WAITING
  CLAIMED
}

model Message {
  id          String        @id @default(cuid())
  sessionId   String
  session     Session       @relation(fields: [sessionId], references: [id])
  sender      MessageSender
  body        String
  urgencyTier UrgencyTier?
  // Global, DB-assigned, strictly increasing — the server-side ordering
  // FR-5.2 requires. Client timestamps are never trusted for ordering.
  sequence    Int           @default(autoincrement())
  createdAt   DateTime      @default(now())

  @@index([sessionId, sequence])
}

enum MessageSender {
  VISITOR
  LISTENER
}

// STANDARD/ELEVATED/URGENT are AI-assigned (docs/challenges/ai-triage.md).
// UNCLASSIFIED is the explicit fallback on classifier failure (FR-6.3) —
// the message still gets stored and delivered, just untagged.
enum UrgencyTier {
  STANDARD
  ELEVATED
  URGENT
  UNCLASSIFIED
}

// email is real, not synthetic seed data — see the narrow carve-out in
// docs/technical-requirements.md.
model Listener {
  id          String    @id @default(cuid())
  email       String    @unique
  isAdmin     Boolean   @default(false) // true only for the seeded admin, "Menty B" (FR-4.4)
  // Public profile fields (FR-9.1) — set at seed time (Menty B) or left for
  // the Listener to fill in later; nullable because approval (T3.5.3)
  // creates the row before the Listener has necessarily chosen either.
  displayName String?
  bio         String?
  sessions    Session[]

  loginTokens ListenerLoginToken[]

  // Reviews this Listener has received vs. authored — two distinct relations
  // on the same model, so both sides need an explicit @relation name.
  reviewsReceived ListenerReview[] @relation("ReviewSubject")
  reviewsAuthored ListenerReview[] @relation("ReviewAuthor")
}

// FR-8 — real applicant data (name, email, message), deliberately never
// joined to visitor Session/Message data (docs/technical-requirements.md's
// carve-out). No FK to Listener: approval creates a separate Listener row
// rather than promoting this one, so a rejected application never becomes
// login-capable just because a field got flipped.
model ListenerApplication {
  id         String            @id @default(cuid())
  name       String
  email      String
  message    String
  status     ApplicationStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  reviewedAt DateTime?

  @@index([status, createdAt])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// FR-9.2 — authorship is enforced by requireListener() at the route level
// (app/api/listeners/[id]/reviews/route.ts): a Listener row only ever exists
// for a seeded or admin-approved account, so "is a Listener" already means
// "is approved" — there's no separate status field to check here.
model ListenerReview {
  id       String @id @default(cuid())
  body     String

  listenerId String
  listener   Listener @relation("ReviewSubject", fields: [listenerId], references: [id], onDelete: Cascade)

  authorListenerId String
  author           Listener @relation("ReviewAuthor", fields: [authorListenerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([listenerId])
}

// Mirrors MagicLinkToken's shape and reasoning (hash only, single-use,
// short TTL) but resolves to a Listener row directly — there's no
// bind-or-resume dance like the visitor flow, since a Listener already
// exists (seeded, never self-serve — see tasks/TASKS.md Milestone 3).
model ListenerLoginToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  listenerId String
  listener   Listener  @relation(fields: [listenerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([listenerId])
}

// Only the hash is stored — same reasoning as a password hash, even though
// the raw token is high-entropy and unguessable: a DB leak or a stray log
// line shouldn't hand out a working sign-in link. See
// docs/challenges/passwordless-auth.md for the full write-up.
model MagicLinkToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  sessionId String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// codeHash, not code: a 6-digit code is low-entropy by nature (1e6
// possibilities), so the real protection is the 5-attempt lockout below,
// not the hash — but there's no reason to store it in the clear either.
model OtpCode {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  sessionId String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone])
}

// One row per registered passkey. credentialId is what a sign-in assertion
// arrives tagged with — that's how we find out *whose* Session this is
// without ever asking for an email or username first (WebAuthn's
// "discoverable credential" flow: the OS's passkey picker IS the identity
// lookup). publicKey is exactly that — public — storing it is not a secret
// disclosure risk the way the magic-link/OTP hashes are about.
model PasskeyCredential {
  id           String   @id @default(cuid())
  sessionId    String
  credentialId String   @unique
  publicKey    String
  counter      Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([sessionId])
}

// A short-lived anti-replay nonce for one registration or authentication
// ceremony. Not an identity lookup (see PasskeyCredential for that) — this
// table only proves "this particular challenge was issued by us, recently,
// and hasn't been used yet."
model PasskeyChallenge {
  id        String    @id @default(cuid())
  challenge String
  sessionId String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}
