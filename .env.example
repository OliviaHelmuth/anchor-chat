# Copy to .env (gitignored) and fill in as each service from
# docs/hosting-and-scaling.md gets provisioned. Nothing here is a real value.
# .env, not .env.local — the Prisma CLI only auto-loads .env, and Next.js
# reads both, so .env is the one file both tools agree on.

# Milestone 0 — T0.2, Neon Postgres (EU/Frankfurt project)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Milestone 0 — T0.4, Ably realtime
ABLY_API_KEY=""

# Milestone 2 — Brevo, for magic-link email. BREVO_SENDER_EMAIL must be a
# sender verified in Brevo's dashboard (Senders, Domains & Dedicated IPs) —
# there's no shared sandbox address like Resend's onboarding@resend.dev.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""

# Milestone 5 — AI triage classifier (pick one; see docs/hosting-and-scaling.md)
GROQ_API_KEY=""
# or: GOOGLE_GENERATIVE_AI_API_KEY=""

# Milestone 0 — T0.6, Sentry — DSN isn't secret, NEXT_PUBLIC_ is intentional
NEXT_PUBLIC_SENTRY_DSN=""

# Auth.js
AUTH_SECRET=""

# Milestone 3 — the one seeded admin Listener account ("Menty B"). Real
# email, not synthetic — see docs/technical-requirements.md's carve-out.
# Used by `npm run db:seed`.
LISTENER_ADMIN_EMAIL=""
