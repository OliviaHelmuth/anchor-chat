# Copy to .env.test (gitignored) to run the Vitest integration suite
# (npm run test:integration) and the Playwright E2E suite (npm run test:e2e)
# locally. See docs/technical-requirements.md's Testing expectations.
#
# Setup once: `brew services start postgresql@14` (or however you run local
# Postgres), then `createdb overshare_test`. integration/env.ts refuses to
# run unless DATABASE_URL contains "overshare_test" — a guard against ever
# pointing these tests at the real dev/prod database.
DATABASE_URL="postgresql://localhost:5432/overshare_test"

# Any value works locally — Auth.js just needs something to sign/verify
# session JWTs with.
AUTH_SECRET="test-secret-do-not-use-in-production"

# `next dev` auto-trusts localhost; the integration/E2E test server runs in
# production mode (`next start`, see next.config.ts's NEXT_TEST_BUILD),
# which rejects an untrusted Host header unless told otherwise.
AUTH_TRUST_HOST="true"

# Deliberately empty (not omitted — see lib/email.ts): this is what makes
# lib/email.ts console-log the magic-link/listener-login URL instead of
# sending real email, which is how tests sign in without a real inbox.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""

# Seeded admin Listener used by npm run db:seed and both test suites.
LISTENER_ADMIN_EMAIL="menty-b-test@example.com"

# Real Ably free-tier key required — realtime isn't mocked (same no-mocks
# convention as this project's manual verification). Copy the value from
# your local .env.
ABLY_API_KEY=""
